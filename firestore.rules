rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // 1. Inspection Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if true;
      allow create, update, delete: if isValidId(reportId);
    }

    // 2. Defect Groups Catalog
    match /defect_groups/{groupId} {
      allow get: if isValidId(groupId);
      allow list: if true;
      allow create, update, delete: if isValidId(groupId);
    }

    // 3. Defect Master Catalog
    match /defect_master/{defectId} {
      allow get: if isValidId(defectId);
      allow list: if true;
      allow create, update, delete: if isValidId(defectId);
    }

    // 4. CAPA Records
    match /capas/{capaId} {
      allow get: if isValidId(capaId);
      allow list: if true;
      allow create, update, delete: if isValidId(capaId);
    }

    // 5. Monitoring & Effectiveness Checks
    match /monitoring/{monitoringId} {
      allow get: if isValidId(monitoringId);
      allow list: if true;
      allow create, update, delete: if isValidId(monitoringId);
    }

    function isValidAppRelease(data) {
      return data.keys().hasAll(['version', 'builtAt', 'host']) &&
        data.keys().hasOnly(['version', 'builtAt', 'host']) &&
        data.version is string && data.version.size() > 0 && data.version.size() <= 64 &&
        data.builtAt is string && data.builtAt.size() > 0 && data.builtAt.size() <= 64 &&
        data.host is string && data.host.size() > 0 && data.host.size() <= 128;
    }

    // 6. Live App Release Manifest (real-time update alerts across users)
    match /app_releases/{hostId} {
      allow get: if isValidId(hostId);
      allow list: if false;
      allow create, update: if isValidId(hostId) && isValidAppRelease(incoming());
      allow delete: if false;
    }
  }
}
