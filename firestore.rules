rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // 1. Inspection Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if true;
      allow create, update, delete: if isValidId(reportId);
    }

    // 2. Defect Groups Catalog
    match /defect_groups/{groupId} {
      allow get: if isValidId(groupId);
      allow list: if true;
      allow create, update, delete: if isValidId(groupId);
    }

    // 3. Defect Master Catalog
    match /defect_master/{defectId} {
      allow get: if isValidId(defectId);
      allow list: if true;
      allow create, update, delete: if isValidId(defectId);
    }

    // 4. CAPA Records
    match /capas/{capaId} {
      allow get: if isValidId(capaId);
      allow list: if true;
      allow create, update, delete: if isValidId(capaId);
    }

    // 5. Monitoring & Effectiveness Checks
    match /monitoring/{monitoringId} {
      allow get: if isValidId(monitoringId);
      allow list: if true;
      allow create, update, delete: if isValidId(monitoringId);
    }
  }
}
